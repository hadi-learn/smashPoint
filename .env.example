# SmashPoint configuration (copy to .env)
PORT=3000
HOST=0.0.0.0
COURT_COUNT=15

# Master PIN 4-digit for Emergency Takeover (PRD 4.2)
MASTER_PIN=1234
# PIN for the Server Admin dashboard (defaults to MASTER_PIN)
ADMIN_PIN=1234

# Match lock is released if no PING is received within this time (PRD 8.2)
LOCK_TIMEOUT_MS=60000

# Optional: Google Apps Script Web App URL (see docs/google-apps-script.gs)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbznFNNc8NllxHkrtlqZsVpQcRHg2i_leMObRyLcFkDbNhNctabRRSqzf_zVjH6D6w8oqQ/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=hasil_pertandingan
